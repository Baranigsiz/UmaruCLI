package components

import "fmt"

templ Counter(count int64) {
	<div id="counter-widget" class="flex flex-col items-center bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl w-full max-w-sm">
		<span class="text-xs uppercase tracking-wider font-semibold text-slate-400 mb-2">Live HTMX Reactive State</span>
		<div class="text-6xl font-black text-indigo-400 my-4 tabular-nums">
			{ fmt.Sprintf("%d", count) }
		</div>
		<div class="flex items-center space-x-3 w-full justify-center">
			<button
				hx-post="/api/counter/decrement"
				hx-target="#counter-widget"
				hx-swap="outerHTML"
				class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-4 py-2 rounded-xl font-bold transition duration-150 active:scale-95 shadow">
				-1
			</button>
			<button
				hx-post="/api/counter/reset"
				hx-target="#counter-widget"
				hx-swap="outerHTML"
				class="bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white px-3 py-2 rounded-xl text-xs font-medium transition duration-150 active:scale-95">
				Reset
			</button>
			<button
				hx-post="/api/counter/increment"
				hx-target="#counter-widget"
				hx-swap="outerHTML"
				class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-xl font-bold transition duration-150 active:scale-95 shadow-lg shadow-indigo-500/25">
				+1
			</button>
		</div>
	</div>
}
