version: '3.8'

services:
  api:
    build:
      context: ./apps/api
      dockerfile: Dockerfile
    container_name: {{.SafeName}}-api
    ports:
      - "8080:8080"
    environment:
      - PORT=8080
      - APP_ENV=production
    restart: unless-stopped

  web:
    build:
      context: ./apps/web
      dockerfile: Dockerfile
    container_name: {{.SafeName}}-web
    ports:
      - "3000:80"
    depends_on:
      - api
    restart: unless-stopped
