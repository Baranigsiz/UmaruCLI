[package]
name = "{{.SafeName}}"
version = "0.1.0"
description = "A Tauri v2 Desktop App"
authors = ["{{.Author}}"]
license = "{{.License}}"
repository = ""
edition = "2021"

[lib]
name = "app_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
tauri = { version = "2", features = [] }
tauri-plugin-opener = "2"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
