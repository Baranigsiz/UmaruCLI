{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{.ProjectName}}",
  "version": "0.1.0",
  "identifier": "com.{{.SafeName}}.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "{{.ProjectName}}",
        "width": 900,
        "height": 650,
        "minWidth": 600,
        "minHeight": 450,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
