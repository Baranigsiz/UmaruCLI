package main

import (
	"fmt"
	"os"

	"{{.ModuleName}}/internal/ui"

	tea "github.com/charmbracelet/bubbletea"
)

func main() {
	p := tea.NewProgram(ui.NewModel("{{.ProjectName}}"), tea.WithAltScreen(), tea.WithMouseCellMotion())
	if _, err := p.Run(); err != nil {
		fmt.Fprintf(os.Stderr, "Error running TUI application: %v\n", err)
		os.Exit(1)
	}
}
