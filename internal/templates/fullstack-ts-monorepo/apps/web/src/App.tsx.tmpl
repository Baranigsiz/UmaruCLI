import React, { useState, useEffect } from 'react'
import { Server, Globe, Zap, Cpu, CheckCircle2, RefreshCw } from 'lucide-react'

interface ApiResponse {
  title: string
  description: string
  timestamp: string
}

function App() {
  const [data, setData] = useState<ApiResponse | null>(null)
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState<string | null>(null)

  const fetchApiData = async () => {
    setLoading(true)
    setError(null)
    try {
      const res = await fetch('/api/message')
      if (!res.ok) {
        throw new Error(`HTTP Error: ${res.status}`)
      }
      const json = await res.json()
      setData(json)
    } catch (err: any) {
      setError(err.message || 'Failed to connect to backend')
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    fetchApiData()
  }, [])

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col items-center justify-center p-6">
      <div className="max-w-4xl w-full space-y-8">
        {/* Header */}
        <div className="text-center space-y-3">
          <div className="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-400 text-sm font-medium">
            <Zap className="w-4 h-4 text-violet-400" />
            <span>Fullstack TypeScript Monorepo</span>
          </div>
          <h1 className="text-4xl md:text-5xl font-extrabold tracking-tight bg-gradient-to-r from-violet-400 via-indigo-300 to-cyan-400 bg-clip-text text-transparent">
            {{.ProjectName}}
          </h1>
          <p className="text-slate-400 text-lg max-w-2xl mx-auto">
            Production-grade monorepo powered by <span className="text-amber-400 font-semibold">Hono</span> backend and <span className="text-cyan-400 font-semibold">React 18 Vite</span> frontend.
          </p>
        </div>

        {/* Live Backend Connection Card */}
        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl backdrop-blur-sm">
          <div className="flex items-center justify-between border-b border-slate-800 pb-4 mb-4">
            <div className="flex items-center gap-3">
              <div className="p-2 rounded-xl bg-violet-500/20 text-violet-400">
                <Server className="w-5 h-5" />
              </div>
              <div>
                <h3 className="font-semibold text-slate-200">Backend Connection Status</h3>
                <p className="text-xs text-slate-400">Live proxy via Vite (/api ➔ http://localhost:3000)</p>
              </div>
            </div>
            <button
              onClick={fetchApiData}
              disabled={loading}
              className="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors disabled:opacity-50"
            >
              <RefreshCw className={`w-3.5 h-3.5 ${loading ? 'animate-spin' : ''}`} />
              <span>Refresh</span>
            </button>
          </div>

          {loading && (
            <div className="py-6 text-center text-sm text-slate-400">
              Connecting to Hono backend...
            </div>
          )}

          {error && (
            <div className="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm">
              ⚠️ Could not connect to Hono API: {error}. Make sure <code className="bg-slate-800 px-1 py-0.5 rounded">npm run dev:api</code> is running on port 3000.
            </div>
          )}

          {data && !loading && (
            <div className="space-y-3 bg-slate-950/60 p-4 rounded-xl border border-slate-800/80">
              <div className="flex items-center gap-2 text-emerald-400 text-sm font-medium">
                <CheckCircle2 className="w-4 h-4" />
                <span>Connected Successfully</span>
              </div>
              <p className="text-slate-200 font-semibold">{data.title}</p>
              <p className="text-sm text-slate-400">{data.description}</p>
              <p className="text-xs text-slate-500 font-mono">Response timestamp: {data.timestamp}</p>
            </div>
          )}
        </div>

        {/* Architecture Grid */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div className="p-5 rounded-xl bg-slate-900/60 border border-slate-800/80 space-y-2">
            <div className="flex items-center gap-2 text-amber-400 font-semibold text-sm">
              <Zap className="w-4 h-4" />
              <span>Hono API (`apps/api`)</span>
            </div>
            <p className="text-xs text-slate-400 leading-relaxed">
              Ultrafast TypeScript backend supporting Node.js, Bun, and Edge runtimes with built-in CORS, Logger, and strict typing.
            </p>
          </div>

          <div className="p-5 rounded-xl bg-slate-900/60 border border-slate-800/80 space-y-2">
            <div className="flex items-center gap-2 text-cyan-400 font-semibold text-sm">
              <Globe className="w-4 h-4" />
              <span>React Vite (`apps/web`)</span>
            </div>
            <p className="text-xs text-slate-400 leading-relaxed">
              Modern frontend with React 18, Tailwind CSS, Lucide icons, and lightning-fast Hot Module Replacement (HMR).
            </p>
          </div>

          <div className="p-5 rounded-xl bg-slate-900/60 border border-slate-800/80 space-y-2">
            <div className="flex items-center gap-2 text-violet-400 font-semibold text-sm">
              <Cpu className="w-4 h-4" />
              <span>Unified Monorepo</span>
            </div>
            <p className="text-xs text-slate-400 leading-relaxed">
              Workspaces configured for npm/pnpm, root dev scripts, unified Docker Compose setup, and production multi-stage builds.
            </p>
          </div>
        </div>
      </div>
    </div>
  )
}

export default App
